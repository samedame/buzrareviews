# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (dashboard.stripe.com -> Developers -> API keys for the secret key;
# Developers -> Webhooks -> your endpoint -> Signing secret for the other)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com/api-keys) + the domain you verified there
RESEND_API_KEY=
SENDING_DOMAIN=buzrareviews.com

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Places API (New) -- Google Cloud Console, no separate approval needed
GOOGLE_PLACES_API_KEY=

# Random secret string -- set the same value in Vercel's env vars and
# Vercel Cron will send it as a Bearer token automatically.
CRON_SECRET=
